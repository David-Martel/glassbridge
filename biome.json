{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!vendor",
      "!data",
      "!output",
      "!staging",
      "!apps/server/dist",
      "!apps/web/dist",
      "!apps/web/src-tauri/gen",
      "!apps/web/src-tauri/target"
    ]
  }
}
